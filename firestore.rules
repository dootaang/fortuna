rules_version = '2';

// 종점도시 포르투나 — Firestore 보안 규칙
//
// 핵심 약속
// 1. 잔액·빚이 바뀌는 쓰기는 반드시 같은 묶음 안에서 ledger/{pid}_{seq} 한 장을 만든다.
//    지갑 규칙은 "새 장부가 함께 생겼는지"만 보고, 장부 규칙이 지갑의 변경 후 상태 전체를 검증한다.
// 2. 장부는 추가만 가능하다. 관리자도 고치거나 지울 수 없다.
// 3. 금고·공동 지갑·모금함·재고·보유 물품을 플레이어가 바꿀 때는 lastLedger로 근거 장부를 가리킨다.
// 4. 주차 계산은 packages/core/src/week.ts와 같다 (KST 월요일 0시).
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 공용 함수 ──
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    // 시세 기록원(Cloudflare Worker의 전용 계정). 시세·소식·청산 표시만 쓴다.
    function isOracle() { return signedIn() && exists(/databases/$(database)/documents/oracles/$(request.auth.uid)); }
    function bindingPath() { return /databases/$(database)/documents/bindings/$(request.auth.uid); }
    function playerPath(pid) { return /databases/$(database)/documents/players/$(pid); }
    function walletPath(pid) { return /databases/$(database)/documents/wallets/$(pid); }
    function ledgerPath(id) { return /databases/$(database)/documents/ledger/$(id); }
    function configPath() { return /databases/$(database)/documents/config/economy; }

    // 이 기기가 pid 캐릭터에 연결되어 있고, 그 연결이 최신 접속 코드 기준인가.
    function isPlayer(pid) {
      return signedIn() && exists(bindingPath())
        && get(bindingPath()).data.playerId == pid
        && get(bindingPath()).data.version == get(playerPath(pid)).data.codeVersion;
    }
    function myPid() { return get(bindingPath()).data.playerId; }

    // 같은 묶음에서 방금 만들어진 장부인가.
    function ledgerCreatedNow(id) { return id is string && !exists(ledgerPath(id)) && existsAfter(ledgerPath(id)); }

    function curWeek() {
      return int(math.floor((request.time.toMillis() + 32400000 - 345600000) / 604800000));
    }

    function curDay() {
      return int(math.floor((request.time.toMillis() + 32400000) / 86400000));
    }

    // config.limitPeriod: 'day'(기본) 또는 'week'. packages/core/src/week.ts와 같은 공식.
    function curPeriod(period) { return period == 'week' ? curWeek() : curDay(); }

    // floor(value * bps / 10000) == result, 정수 연산만으로.
    function isBpsFloor(result, value, bps) {
      return result is int && result * 10000 <= value * bps && (result + 1) * 10000 > value * bps;
    }

    function onlyChanged(before, after, keys) { return after.diff(before).affectedKeys().hasOnly(keys); }

    // 사용 횟수: 주기(하루/주)가 바뀌었으면 0부터 다시 센다.
    function countersOk(before, after, kind, limit, period) {
      let current = curPeriod(period);
      let fresh = before.get('periodIndex', -1) != current;
      let workBase = fresh ? 0 : before.workUsed;
      let gambleBase = fresh ? 0 : before.gambleUsed;
      return after.periodIndex == current
        && after.workUsed == workBase + (kind == 'work' ? 1 : 0)
        && after.gambleUsed == gambleBase + (kind == 'gamble' ? 1 : 0)
        && (kind == 'work' ? after.workUsed <= limit : after.gambleUsed <= limit);
    }

    // ── 관리자와 설정 ──
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isAdmin();
      allow write: if false; // 콘솔에서만 만든다.
    }

    match /config/{name} {
      allow read: if signedIn();
      allow write: if isAdmin();
      // 지배인 금리 결정: 기록원은 예고된 결정이 발표되는 순간 그 이자율만 바꾼다(거래소 2부 4-5).
      allow update: if name == 'market' && isOracle()
        && onlyChanged(resource.data, request.resource.data, ['interestBps', 'lastRate'])
        && rateApplied(request.resource.data.lastRate, request.resource.data.interestBps);
    }

    function rateApplied(eventId, bps) {
      let before = get(/databases/$(database)/documents/marketEvents/$(eventId)).data;
      let after = getAfter(/databases/$(database)/documents/marketEvents/$(eventId)).data;
      return eventId is string && before.kind == 'rate' && before.status == 'pending' && after.status == 'done'
        && before.bps == bps && before.at <= request.time;
    }

    match /districts/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // 클라이언트 시계 보정용: 서버 시각을 한 번 찍어 보고 차이를 잰다.
    match /clocks/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['t']) && request.resource.data.t == request.time;
    }

    match /adminLog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.actorUid == request.auth.uid && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // ── 접속 코드와 연결 ──
    match /accessCodes/{hash} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /playerSecrets/{pid} {
      allow read, write: if isAdmin();
    }

    match /bindings/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid && validBinding();
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    function validBinding() {
      let b = request.resource.data;
      let code = get(/databases/$(database)/documents/accessCodes/$(b.codeHash)).data;
      return b.keys().hasOnly(['playerId', 'codeHash', 'version', 'boundAt'])
        && code.playerId == b.playerId
        && code.version == b.version
        && get(playerPath(b.playerId)).data.codeVersion == b.version
        && b.boundAt == request.time;
    }

    match /players/{pid} {
      // 기록원은 구역 주민 활동을 세려고 주민 구역을 읽는다(거래소 2부 4-1).
      allow read: if isAdmin() || isPlayer(pid) || isOracle();
      allow write: if isAdmin();
    }

    // ── 지갑 ──
    match /wallets/{pid} {
      allow read: if isAdmin() || isPlayer(pid) || isOracle();
      allow create: if isAdmin() && request.resource.data == {
        'playerId': pid, 'balance': 0, 'debt': 0, 'seq': 0, 'arrived': false,
        'periodIndex': 0, 'workUsed': 0, 'gambleUsed': 0, 'openWager': null, 'room': null,
        'market': {'period': 0, 'used': 0, 'open': 0}, 'spot': {'period': 0, 'used': 0}
      };
      // 신원 확인은 장부 규칙이 한다(장부는 본인 또는 관리자만 만들 수 있다).
      allow update: if signedIn() && (ledgerBacked(pid) || (isPlayer(pid) && wagerStep()));
      allow delete: if isAdmin();
    }

    function ledgerBacked(pid) {
      return request.resource.data.seq == resource.data.seq + 1
        && ledgerCreatedNow(pid + '_' + string(request.resource.data.seq));
    }

    // 진행 중인 판에 결정 하나를 봉인한다. 코인은 움직이지 않는다.
    function wagerStep() {
      let before = resource.data.openWager;
      let after = request.resource.data.openWager;
      let key = string(before.stepCount + 1);
      return before != null && after != null
        && onlyChanged(resource.data, request.resource.data, ['openWager'])
        && onlyChanged(before, after, ['stepCount', 'steps'])
        && after.stepCount == before.stepCount + 1
        && after.stepCount <= 60
        && after.steps.diff(before.steps).affectedKeys().hasOnly([key])
        && after.steps[key].keys().hasOnly(['a', 't'])
        && after.steps[key].a is string
        && after.steps[key].a.size() <= 24
        && after.steps[key].t == request.time;
    }

    // ── 장부 ──
    match /ledger/{entryId} {
      allow read: if isAdmin() || isOracle() || (signedIn() && resource.data.playerId == myPid() && isPlayer(resource.data.playerId));
      allow create: if validLedger(entryId);
      allow update, delete: if false;
    }

    function validLedger(entryId) {
      let e = request.resource.data;
      let pid = e.playerId;
      let before = get(walletPath(pid)).data;
      let after = getAfter(walletPath(pid)).data;
      return e.keys().hasOnly(['playerId', 'seq', 'type', 'delta', 'debtDelta', 'vaultDelta', 'balanceAfter', 'debtAfter', 'weekIndex', 'actor', 'actorUid', 'memo', 'detail', 'at'])
        && entryId == pid + '_' + string(e.seq)
        && e.seq == before.seq + 1
        && after.seq == e.seq
        && after.playerId == pid
        && e.delta is int && e.debtDelta is int && e.vaultDelta is int
        && after.balance == before.balance + e.delta
        && after.debt == before.debt + e.debtDelta
        && after.balance >= 0 && after.debt >= 0
        && e.balanceAfter == after.balance && e.debtAfter == after.debt
        && e.at == request.time
        && e.weekIndex == curWeek()
        && e.actorUid == request.auth.uid
        && e.detail is map
        && e.memo is string
        && (e.vaultDelta == 0 || vaultMoved(entryId, e.vaultDelta))
        && (
          (e.actor == 'admin' && isAdmin() && adminEntry(entryId, e, before, after))
          || (e.actor == 'player' && isPlayer(pid) && e.memo == '' && playerEntry(entryId, e, before, after))
        );
    }

    function vaultMoved(entryId, amount) {
      let v0 = get(/databases/$(database)/documents/vault/main).data;
      let v1 = getAfter(/databases/$(database)/documents/vault/main).data;
      return v1.amount == v0.amount + amount && v1.lastLedger == entryId;
    }

    function playerEntry(entryId, e, before, after) {
      return before.arrived == (e.type != 'arrival') && (
        (e.type == 'arrival' && arrivalOk(e, before, after))
        || (e.type == 'work' && workOk(e, before, after))
        || (e.type == 'betOpen' && betOpenOk(entryId, e, before, after))
        || (e.type == 'betSettle' && betSettleOk(e, before, after))
        || (e.type == 'skill' && skillOk(e, before, after))
        || (e.type == 'repay' && repayOk(e, before, after))
        || (e.type == 'jointDeposit' && jointOk(entryId, e, before, after))
        || (e.type == 'fundContribution' && fundOk(entryId, e, before, after))
        || (e.type == 'shop' && shopOk(entryId, e, before, after))
        || (e.type == 'itemUse' && itemUseOk(entryId, e, before, after, false))
        || (e.type == 'pvpStake' && pvpStakeOk(entryId, e, before, after))
        || (e.type == 'pvpPayout' && pvpPayoutOk(entryId, e, before, after))
        || (e.type == 'marketOpen' && marketOpenOk(entryId, e, before, after))
        || (e.type == 'marketClose' && marketCloseOk(entryId, e, before, after))
        || (e.type == 'spotBuy' && spotBuyOk(entryId, e, before, after))
        || (e.type == 'spotSell' && spotSellOk(entryId, e, before, after))
      );
    }

    function arrivalOk(e, before, after) {
      let welcome = get(configPath()).data.welcome;
      return after.arrived == true
        && e.detail == {'loan': welcome.loan, 'gateFee': welcome.gateFee, 'debt': welcome.debt}
        && e.delta == welcome.loan - welcome.gateFee
        && e.debtDelta == welcome.debt
        && e.vaultDelta == welcome.gateFee
        && onlyChanged(before, after, ['balance', 'debt', 'seq', 'arrived']);
    }

    function workOk(e, before, after) {
      let config = get(configPath()).data;
      let work = config.work;
      let d = e.detail;
      let player = get(playerPath(e.playerId)).data;
      let district = get(/databases/$(database)/documents/districts/$(player.districtId)).data;
      let bps = district.liberated == true ? 0 : district.deductionBps;
      return d.keys().hasOnly(['template', 'performance', 'districtId', 'gross', 'deductionBps', 'deduction', 'net'])
        && d.template is string && d.template.size() <= 20
        && d.performance is number && d.performance >= 0 && d.performance <= 1
        && d.districtId == player.districtId
        && d.gross is int && d.gross >= work.wageMin && d.gross <= work.wageMax
        && d.deductionBps == bps
        && isBpsFloor(d.deduction, d.gross, bps)
        && d.net == d.gross - d.deduction
        && e.delta == d.net && e.debtDelta == 0 && e.vaultDelta == d.deduction
        && countersOk(before, after, 'work', work.get('limit', work.get('weeklyLimit', 10)), config.get('limitPeriod', 'day'))
        && onlyChanged(before, after, ['balance', 'seq', 'periodIndex', 'workUsed', 'gambleUsed']);
    }

    function betOpenOk(entryId, e, before, after) {
      let config = get(configPath()).data;
      let gambling = config.gambling;
      let d = e.detail;
      let table = gambling.games[d.game][d.venue];
      let maxBet = d.venue == 'house' ? gambling.houseMaxBet : gambling.alleyMaxBet;
      return d.keys().hasOnly(['game', 'venue', 'bet'])
        && before.openWager == null
        && (d.venue == 'alley' || (d.venue == 'house' && gambling.houseOpen == true))
        && table.enabled == true
        && d.bet is int && d.bet >= gambling.minBet && d.bet <= maxBet
        && e.delta == -d.bet && e.debtDelta == 0
        && e.vaultDelta == (d.venue == 'house' ? d.bet : 0)
        && after.openWager == {
          'wagerId': entryId, 'game': d.game, 'venue': d.venue, 'bet': d.bet,
          'maxMultiplier': table.maxMultiplier, 'params': table.params,
          'openedAt': request.time, 'stepCount': 0, 'steps': {}
        }
        && countersOk(before, after, 'gamble', gambling.get('limit', gambling.get('weeklyLimit', 30)), config.get('limitPeriod', 'day'))
        && onlyChanged(before, after, ['balance', 'seq', 'periodIndex', 'workUsed', 'gambleUsed', 'openWager']);
    }

    // 지급액은 판돈 × 최대 배수를 넘을 수 없다. 실제 결과는 관리자 감사(재생)로 검증한다.
    function betSettleOk(e, before, after) {
      let w = before.openWager;
      let d = e.detail;
      return w != null
        && d.keys().hasOnly(['wagerId', 'game', 'venue', 'bet', 'params', 'payout', 'openedAt', 'stepCount', 'steps', 'summary'])
        && d.wagerId == w.wagerId && d.game == w.game && d.venue == w.venue && d.bet == w.bet && d.params == w.params
        && d.openedAt == w.openedAt && d.stepCount == w.stepCount && d.steps == w.steps
        && d.summary is string && d.summary.size() <= 200
        && d.payout is int && d.payout >= 0 && d.payout <= w.bet * w.maxMultiplier
        && e.delta == d.payout && e.debtDelta == 0
        && e.vaultDelta == (w.venue == 'house' ? -d.payout : 0)
        && after.openWager == null
        && onlyChanged(before, after, ['balance', 'seq', 'openWager']);
    }

    function skillOk(e, before, after) {
      let config = get(configPath()).data;
      let d = e.detail;
      let skill = get(playerPath(e.playerId)).data.skills[d.skillId];
      let cumulative = config.skill.cumulative;
      return d.keys().hasOnly(['skillId', 'skillName', 'baseLevel', 'usedLevel', 'cost', 'borrowed', 'note'])
        && d.skillName == skill.name && d.baseLevel == skill.level && d.baseLevel >= 1
        && d.usedLevel is int && d.usedLevel >= d.baseLevel && d.usedLevel < cumulative.size()
        && d.cost == cumulative[d.usedLevel] - cumulative[d.baseLevel - 1]
        && d.note is string && d.note.size() <= 200
        && d.borrowed is int
        && (d.borrowed == 0
            || (config.borrow.enabled == true && before.balance < d.cost && d.borrowed == d.cost - before.balance))
        && e.delta == d.borrowed - d.cost
        && e.debtDelta - d.borrowed >= 0
        && isBpsFloor(e.debtDelta - d.borrowed, d.borrowed, config.borrow.feeBps)
        && e.vaultDelta == 0
        && onlyChanged(before, after, ['balance', 'debt', 'seq']);
    }

    function repayOk(e, before, after) {
      let d = e.detail;
      return d.keys().hasOnly(['amount'])
        && d.amount is int && d.amount > 0 && d.amount <= before.debt
        && e.delta == -d.amount && e.debtDelta == -d.amount && e.vaultDelta == d.amount
        && onlyChanged(before, after, ['balance', 'debt', 'seq']);
    }

    function jointOk(entryId, e, before, after) {
      let d = e.detail;
      let t0 = get(/databases/$(database)/documents/treasury/joint).data;
      let t1 = getAfter(/databases/$(database)/documents/treasury/joint).data;
      return d.keys().hasOnly(['amount'])
        && d.amount is int && d.amount > 0
        && e.delta == -d.amount && e.debtDelta == 0 && e.vaultDelta == 0
        && t1.amount == t0.amount + d.amount && t1.lastLedger == entryId
        && onlyChanged(before, after, ['balance', 'seq']);
    }

    function fundOk(entryId, e, before, after) {
      let d = e.detail;
      let f0 = get(/databases/$(database)/documents/funds/$(d.fundId)).data;
      let f1 = getAfter(/databases/$(database)/documents/funds/$(d.fundId)).data;
      return d.keys().hasOnly(['fundId', 'title', 'amount', 'filled'])
        && d.title == f0.title
        && d.amount is int && d.amount > 0
        && f0.status == 'open' && f0.visible == true
        && f1.current == f0.current + d.amount && f1.current <= f0.goal
        && f1.status == (f1.current == f0.goal ? 'filled' : 'open')
        && d.filled == (f1.status == 'filled')
        && f1.lastLedger == entryId
        && e.delta == -d.amount && e.debtDelta == 0 && e.vaultDelta == 0
        && onlyChanged(before, after, ['balance', 'seq']);
    }

    function inventoryPath(pid, itemId) { return /databases/$(database)/documents/inventory/$(pid + '_' + itemId); }

    function shopOk(entryId, e, before, after) {
      let d = e.detail;
      let i0 = get(/databases/$(database)/documents/shopItems/$(d.itemId)).data;
      let i1 = getAfter(/databases/$(database)/documents/shopItems/$(d.itemId)).data;
      let path = inventoryPath(e.playerId, d.itemId);
      let had = exists(path);
      let inv1 = getAfter(path).data;
      let purchased0 = had ? get(path).data.purchased : 0;
      let quantity0 = had ? get(path).data.quantity : 0;
      let used0 = had ? get(path).data.used : 0;
      return d.keys().hasOnly(['itemId', 'itemName', 'category', 'quantity', 'unitPrice', 'total'])
        && i0.visible == true
        && d.itemName == i0.name && d.category == i0.category && d.unitPrice == i0.price
        && d.quantity is int && d.quantity >= 1 && d.quantity <= 99
        && d.total == d.unitPrice * d.quantity
        && (i0.stock == null ? i1 == i0 : (i1.stock == i0.stock - d.quantity && i1.stock >= 0 && i1.lastLedger == entryId))
        && inv1.keys().hasOnly(['playerId', 'itemId', 'itemName', 'category', 'consumable', 'purchased', 'quantity', 'used', 'lastLedger'])
        && inv1.playerId == e.playerId && inv1.itemId == d.itemId
        && inv1.itemName == i0.name && inv1.category == i0.category && inv1.consumable == i0.consumable
        && inv1.purchased == purchased0 + d.quantity
        && inv1.quantity == quantity0 + d.quantity
        && inv1.used == used0
        && (i0.perPlayerLimit == null || inv1.purchased <= i0.perPlayerLimit)
        && inv1.lastLedger == entryId
        && e.delta == -d.total && e.debtDelta == 0 && e.vaultDelta == 0
        && onlyChanged(before, after, ['balance', 'seq']);
    }

    function itemUseOk(entryId, e, before, after, byAdmin) {
      let d = e.detail;
      let path = inventoryPath(e.playerId, d.itemId);
      let inv0 = get(path).data;
      let inv1 = getAfter(path).data;
      return d.keys().hasOnly(['itemId', 'itemName'])
        && d.itemName == inv0.itemName
        && (byAdmin || inv0.consumable == true)
        && inv0.quantity >= 1
        && onlyChanged(inv0, inv1, ['quantity', 'used', 'lastLedger'])
        && inv1.quantity == inv0.quantity - 1 && inv1.used == inv0.used + 1
        && inv1.lastLedger == entryId
        && e.delta == 0 && e.debtDelta == 0 && e.vaultDelta == 0
        && onlyChanged(before, after, ['seq']);
    }

    // 관리자 조정: 사유 메모 필수. 진행 중인 판을 강제로 닫을 수 있다.
    function adminEntry(entryId, e, before, after) {
      return e.memo.size() > 0 && e.memo.size() <= 300 && (
        (e.type == 'adminAdjust'
          && e.detail.keys().hasOnly(['reason', 'source'])
          && e.vaultDelta == 0
          && onlyChanged(before, after, ['balance', 'debt', 'seq', 'openWager', 'arrived'])
          && (after.openWager == before.openWager || after.openWager == null))
        || (e.type == 'itemUse' && itemUseOk(entryId, e, before, after, true))
      );
    }

    // ── 공용 금고 ──
    match /vault/{name} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() && followsLedger(['amount', 'lastLedger']));
    }

    match /treasury/{name} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() && followsLedger(['amount', 'lastLedger']));
    }

    match /funds/{fundId} {
      allow read: if isAdmin() || (signedIn() && resource.data.visible == true);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() && followsLedger(['current', 'status', 'lastLedger']));
    }

    // 바뀐 필드가 keys 안이고, lastLedger가 이번 묶음에서 이 사용자가 만든 장부를 가리킨다.
    // 금액이 맞는지는 그 장부 규칙이 확인한다.
    function followsLedger(keys) {
      let id = request.resource.data.lastLedger;
      return onlyChanged(resource.data, request.resource.data, keys)
        && ledgerCreatedNow(id)
        && getAfter(ledgerPath(id)).data.actorUid == request.auth.uid;
    }

    // ── 상점 ──
    match /shopItems/{itemId} {
      allow read: if isAdmin() || (signedIn() && resource.data.visible == true);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() && followsLedger(['stock', 'lastLedger']));

      match /secret/{name} {
        allow read: if isAdmin() || (signedIn() && exists(bindingPath()) && isPlayer(myPid()) && exists(inventoryPath(myPid(), itemId)));
        allow write: if isAdmin();
      }
    }

    match /inventory/{id} {
      // get은 아직 없는 문서(첫 구매 전)도 허용해야 하므로 문서 id로 판단한다.
      allow get: if isAdmin() || (signedIn() && exists(bindingPath()) && id.matches(myPid() + '_.+') && isPlayer(myPid()));
      allow list: if isAdmin() || (signedIn() && resource.data.playerId == myPid() && isPlayer(resource.data.playerId));
      allow create, update: if signedIn()
        && id == request.resource.data.playerId + '_' + request.resource.data.itemId
        && ledgerCreatedNow(request.resource.data.lastLedger)
        && getAfter(ledgerPath(request.resource.data.lastLedger)).data.playerId == request.resource.data.playerId;
      allow delete: if isAdmin();
    }


    // ── PvP 도둑잡기 ──
    // 방 문서는 공개(카드 묶음 포함), 카드 순서는 hands/{pid}에 본인만. 배분은 pvpDeals 표에서 봉인된 시각으로 고른다.
    function roomPath(id) { return /databases/$(database)/documents/pvpRooms/$(id); }
    function handPath(roomId, pid) { return /databases/$(database)/documents/pvpRooms/$(roomId)/hands/$(pid); }
    function dealPath(n, k) { return /databases/$(database)/documents/pvpDeals/$(string(n) + '_' + string(k)); }
    // 설정 문서가 PvP 추가 전 형식이어도 기본값으로 동작한다 (packages/core DEFAULT_ECONOMY.pvp와 같은 값).
    function pvpConfig() {
      return get(configPath()).data.get('pvp', {'enabled': true, 'minStake': 10, 'alleyMaxStake': 200, 'houseMaxStake': 2000, 'alleyRakeBps': 0, 'houseRakeBps': 500,
        'offerSeconds': 12, 'pickSeconds': 20, 'resolveSeconds': 8, 'abandonMinutes': 30});
    }
    function seatedIn(room) { return signedIn() && exists(bindingPath()) && myPid() in room.seats && isPlayer(myPid()); }
    function elapsed(ts, seconds) { return request.time > ts + duration.value(seconds, 's'); }
    function onlyAdded(before, after, key) {
      return after.diff(before).addedKeys() == [key].toSet() && after.diff(before).changedKeys().size() == 0 && after.diff(before).removedKeys().size() == 0;
    }
    function ledgerOfType(id, type, pid, roomId) {
      let entry = getAfter(ledgerPath(id)).data;
      return ledgerCreatedNow(id) && entry.type == type && entry.playerId == pid && entry.detail.roomId == roomId;
    }
    function freshTurn(actor, target) {
      return {'actor': actor, 'target': target, 'since': request.time, 'offerReady': false, 'raised': null, 'reorders': 0, 'pick': null};
    }

    match /pvpDeals/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /pvpRooms/{roomId} {
      allow read: if signedIn();
      allow create: if roomCreateOk(roomId);
      allow update: if signedIn() && roomUpdateOk(roomId, resource.data, request.resource.data);
      allow delete: if false;

      match /hands/{pid} {
        allow read: if signedIn() && isPlayer(pid);
        allow write: if signedIn() && isPlayer(pid)
          && request.resource.data.keys().hasOnly(['order'])
          && request.resource.data.order.size() == getAfter(roomPath(roomId)).data.sets[pid].size()
          && request.resource.data.order.toSet() == getAfter(roomPath(roomId)).data.sets[pid].toSet();
      }

      match /presence/{pid} {
        allow read: if signedIn();
        allow write: if signedIn() && isPlayer(pid)
          && request.resource.data.keys().hasOnly(['lastSeen', 'emote', 'emoteAt', 'hover'])
          && request.resource.data.lastSeen == request.time;
      }
    }

    function roomCreateOk(roomId) {
      let r = request.resource.data;
      let config = get(configPath()).data;
      let pvp = pvpConfig();
      let pid = myPid();
      return signedIn() && isPlayer(pid) && pvp.enabled == true
        && r.keys().hasOnly(['game', 'venue', 'stake', 'maxSeats', 'rakeBps', 'status', 'hostPid', 'createdAt', 'seats', 'seatCount', 'pot', 'op', 'lastLedger'])
        && r.game == 'old-maid' && r.op == 'create' && r.status == 'waiting'
        && (r.venue == 'alley' || (r.venue == 'house' && config.gambling.houseOpen == true))
        && r.stake is int && r.stake >= pvp.minStake && r.stake <= (r.venue == 'house' ? pvp.houseMaxStake : pvp.alleyMaxStake)
        && r.rakeBps == (r.venue == 'house' ? pvp.houseRakeBps : pvp.alleyRakeBps)
        && r.maxSeats is int && r.maxSeats >= 2 && r.maxSeats <= 4
        && r.hostPid == pid && r.createdAt == request.time
        && r.seats.keys().hasOnly([pid]) && r.seats[pid] == {'name': get(playerPath(pid)).data.name, 'joinedAt': request.time}
        && r.seatCount == 1 && r.pot == r.stake
        && ledgerOfType(r.lastLedger, 'pvpStake', pid, roomId);
    }

    function roomUpdateOk(roomId, r0, r1) {
      let op = r1.op;
      return (op == 'join' && joinOk(roomId, r0, r1))
        || (op == 'leave' && leaveOk(roomId, r0, r1))
        || (op == 'start' && startOk(r0, r1))
        || (op == 'deal' && dealOk(r0, r1))
        || (op == 'raise' && offerOk(r0, r1, 'raised'))
        || (op == 'reorder' && offerOk(r0, r1, 'reorders'))
        || (op == 'ready' && offerOk(r0, r1, 'offerReady'))
        || (op == 'pick' && pickOk(r0, r1, false))
        || (op == 'autoPick' && pickOk(r0, r1, true))
        || (op == 'resolve' && resolveOk(roomId, r0, r1, false))
        || (op == 'autoResolve' && resolveOk(roomId, r0, r1, true))
        || (op == 'claim' && claimOk(roomId, r0, r1))
        || ((op == 'cancel' || op == 'abandon' || op == 'void') && closeOk(r0, r1));
    }

    function joinOk(roomId, r0, r1) {
      let pid = myPid();
      return r0.status == 'waiting' && isPlayer(pid) && !(pid in r0.seats) && r0.seatCount < r0.maxSeats
        && onlyChanged(r0, r1, ['seats', 'seatCount', 'pot', 'op', 'lastLedger'])
        && onlyAdded(r0.seats, r1.seats, pid)
        && r1.seats[pid] == {'name': get(playerPath(pid)).data.name, 'joinedAt': request.time}
        && r1.seatCount == r0.seatCount + 1 && r1.pot == r0.pot + r0.stake
        && ledgerOfType(r1.lastLedger, 'pvpStake', pid, roomId);
    }

    function leaveOk(roomId, r0, r1) {
      let pid = myPid();
      return r0.status == 'waiting' && isPlayer(pid) && pid in r0.seats
        && onlyChanged(r0, r1, ['seats', 'seatCount', 'pot', 'op', 'lastLedger', 'hostPid', 'status'])
        && r1.seats.diff(r0.seats).removedKeys() == [pid].toSet() && r1.seats.diff(r0.seats).addedKeys().size() == 0
        && r1.seatCount == r0.seatCount - 1 && r1.pot == r0.pot - r0.stake
        && (r1.seatCount == 0
              ? r1.status == 'closed'
              : (r1.status == 'waiting' && r1.hostPid in r1.seats && (r0.hostPid == pid || r1.hostPid == r0.hostPid)))
        && ledgerOfType(r1.lastLedger, 'pvpPayout', pid, roomId);
    }

    function startOk(r0, r1) {
      let n = r0.seatCount;
      return r0.status == 'waiting' && r0.hostPid == myPid() && isPlayer(myPid()) && n >= 2
        && onlyChanged(r0, r1, ['status', 'op', 'order', 'pos', 'startedAt'])
        && r1.status == 'dealing' && r1.startedAt == request.time
        && r1.order.size() == n && r1.order.toSet() == r0.seats.keys().toSet()
        && r1.pos.size() == n && r1.pos[r1.order[0]] == 0 && r1.pos[r1.order[1]] == 1
        && (n < 3 || r1.pos[r1.order[2]] == 2) && (n < 4 || r1.pos[r1.order[3]] == 3);
    }

    // 배분은 표에서 그대로: 봉인된 시작 시각이 표 번호를 정한다.
    function dealOk(r0, r1) {
      let n = r0.seatCount;
      let k = r0.startedAt.toMillis() % 256;
      let table = get(dealPath(n, k)).data;
      return r0.status == 'dealing' && seatedIn(r0)
        && onlyChanged(r0, r1, ['status', 'op', 'dealIndex', 'sets', 'discards', 'turn', 'moves', 'lastMove'])
        && r1.status == 'playing' && r1.dealIndex == k && r1.sets.size() == n
        && r1.sets[r0.order[0]] == table.seats['0'] && r1.sets[r0.order[1]] == table.seats['1']
        && (n < 3 || r1.sets[r0.order[2]] == table.seats['2']) && (n < 4 || r1.sets[r0.order[3]] == table.seats['3'])
        && r1.discards == table.discards && r1.moves == 0 && r1.lastMove == null
        && r1.turn == freshTurn(r0.order[0], r0.order[1]);
    }

    // 제시자(뽑히는 사람)의 공개 동작: 카드 내밀기, 재배열 횟수, 준비 완료.
    function offerOk(r0, r1, field) {
      let t0 = r0.turn;
      let t1 = r1.turn;
      return r0.status == 'playing' && t0.target == myPid() && isPlayer(myPid()) && t0.pick == null
        && onlyChanged(r0, r1, ['turn', 'op']) && onlyChanged(t0, t1, [field])
        && (field != 'raised' || t1.raised == null || (t1.raised is int && t1.raised >= 0 && t1.raised < r0.sets[t0.target].size()))
        && (field != 'reorders' || (t1.reorders == t0.reorders + 1 && t1.reorders <= 3))
        && (field != 'offerReady' || t1.offerReady == true);
    }

    // 뽑기 지정. 대행(auto)은 시간 초과 뒤 누구나, 위치는 봉인된 시각으로 정해진다(index null).
    function pickOk(r0, r1, auto) {
      let t0 = r0.turn;
      let t1 = r1.turn;
      let pvp = pvpConfig();
      return r0.status == 'playing' && t0.pick == null
        && onlyChanged(r0, r1, ['turn', 'op']) && onlyChanged(t0, t1, ['pick'])
        && (auto
              ? (seatedIn(r0) && elapsed(t0.since, pvp.offerSeconds + pvp.pickSeconds)
                 && t1.pick == {'index': null, 'at': request.time, 'auto': true})
              : (t0.actor == myPid() && isPlayer(myPid())
                 && (t0.offerReady == true || elapsed(t0.since, pvp.offerSeconds))
                 && t1.pick.keys().hasOnly(['index', 'at', 'auto'])
                 && t1.pick.index is int && t1.pick.index >= 0 && t1.pick.index < r0.sets[t0.target].size()
                 && t1.pick.at == request.time && t1.pick.auto == false));
    }

    // 카드 넘기기. 제시자는 자기 비공개 순서에서 정확히 그 위치의 카드를, 대행은 공개 묶음에서 봉인된 시각 위치의 카드를.
    function resolveOk(roomId, r0, r1, auto) {
      let t0 = r0.turn;
      let pick = t0.pick;
      let b = t0.target;
      let from = r0.sets[b];
      let order = auto ? from : get(handPath(roomId, b)).data.order;
      let index = (auto || pick.index == null) ? pick.at.toMillis() % from.size() : pick.index;
      return r0.status == 'playing' && pick != null
        && (auto
              ? (seatedIn(r0) && elapsed(pick.at, pvpConfig().resolveSeconds))
              : (b == myPid() && isPlayer(b) && order.size() == from.size() && order.toSet() == from.toSet()))
        && drawOk(r0, r1, t0.actor, b, order[index], auto);
    }

    function partnerCard(card) {
      return card == 'joker' ? 'none' : ((card.split('-')[0] == 'hearts' ? 'spades' : 'hearts') + '-' + card.split('-')[1]);
    }

    function drawOk(r0, r1, a, b, card, auto) {
      let partner = partnerCard(card);
      let paired = partner in r0.sets[a];
      let fromAfter = r0.sets[b].removeAll([card]);
      let toAfter = paired ? r0.sets[a].removeAll([partner]) : r0.sets[a].concat([card]);
      let thrown = paired ? [card, partner] : [];
      let emptied = (fromAfter.size() == 0 ? [b] : []).concat(toAfter.size() == 0 ? [a] : []);
      return r1.sets.diff(r0.sets).affectedKeys().hasOnly([a, b])
        && r1.sets[a] == toAfter && r1.sets[b] == fromAfter
        && r1.discards == r0.discards.concat(thrown)
        && r1.moves == r0.moves + 1
        && r1.lastMove == {'actor': a, 'target': b, 'card': card, 'thrown': thrown, 'auto': auto, 'at': request.time}
        && (emptied.size() == 0
              ? (onlyChanged(r0, r1, ['sets', 'discards', 'moves', 'lastMove', 'turn', 'op'])
                 && r1.turn == freshTurn(b, r0.order[(r0.pos[b] + 1) % r0.order.size()]))
              : finishOk(r0, r1, emptied));
    }

    // 승자독식: 먼저 턴 사람(동시면 나눔)이 수수료를 뺀 판을 가져간다.
    function finishOk(r0, r1, emptied) {
      let w = emptied.size();
      let net = r0.pot - r1.rake;
      return onlyChanged(r0, r1, ['sets', 'discards', 'moves', 'lastMove', 'turn', 'op', 'status', 'winners', 'jokerHolder', 'rake', 'share', 'remainder', 'claimed'])
        && r1.status == 'finished' && r1.turn == null && r1.winners == emptied
        && r1.jokerHolder in r1.sets && 'joker' in r1.sets[r1.jokerHolder]
        && isBpsFloor(r1.rake, r0.pot, r0.rakeBps)
        && r1.share is int && r1.share * w <= net && (r1.share + 1) * w > net
        && r1.remainder == net - r1.share * w
        && r1.claimed == {};
    }

    function claimOk(roomId, r0, r1) {
      let pid = myPid();
      let claimed = r0.get('claimed', {});
      return (r0.status == 'finished' || r0.status == 'void') && isPlayer(pid) && pid in r0.seats && !(pid in claimed)
        && onlyChanged(r0, r1, ['claimed', 'op', 'lastLedger'])
        && onlyAdded(claimed, r1.claimed, pid) && r1.claimed[pid] == true
        && ledgerOfType(r1.lastLedger, 'pvpPayout', pid, roomId);
    }

    // 방장 취소(대기 중), 오래 버려진 대기실 정리, 딜러의 강제 무효. 무효가 되면 각자 판돈을 돌려받는다.
    function closeOk(r0, r1) {
      return onlyChanged(r0, r1, ['status', 'op', 'claimed']) && r1.status == 'void' && r1.claimed == {}
        && ((r1.op == 'cancel' && r0.status == 'waiting' && r0.hostPid == myPid() && isPlayer(myPid()))
            || (r1.op == 'abandon' && r0.status == 'waiting' && seatedIn(r0) && elapsed(r0.createdAt, pvpConfig().abandonMinutes * 60))
            || (r1.op == 'void' && isAdmin() && (r0.status == 'waiting' || r0.status == 'dealing' || r0.status == 'playing')));
    }

    function pvpStakeOk(entryId, e, before, after) {
      let d = e.detail;
      let room = getAfter(roomPath(d.roomId)).data;
      return d.keys().hasOnly(['roomId', 'stake', 'venue'])
        && before.get('room', null) == null && after.room == d.roomId
        && room.lastLedger == entryId && d.stake == room.stake && d.venue == room.venue
        && e.delta == -d.stake && e.debtDelta == 0 && e.vaultDelta == 0
        && onlyChanged(before, after, ['balance', 'seq', 'room']);
    }

    function pvpPayoutOk(entryId, e, before, after) {
      let d = e.detail;
      let r0 = get(roomPath(d.roomId)).data;
      let r1 = getAfter(roomPath(d.roomId)).data;
      let pid = e.playerId;
      let won = r0.status == 'finished' && pid in r0.winners;
      let amount = (d.kind == 'leave' || d.kind == 'refund') ? r0.stake : (won ? r0.share : 0);
      let houseCut = (r0.status == 'finished' && r0.winners[0] == pid) ? r0.rake + r0.remainder : 0;
      return d.keys().hasOnly(['roomId', 'kind'])
        && before.get('room', null) == d.roomId && after.room == null
        && r1.lastLedger == entryId
        && ((d.kind == 'leave' && r0.status == 'waiting' && r1.op == 'leave')
            || (d.kind == 'refund' && r0.status == 'void' && r1.op == 'claim')
            || (d.kind == (won ? 'win' : 'lose') && r0.status == 'finished' && r1.op == 'claim'))
        && e.delta == amount && e.debtDelta == 0
        && e.vaultDelta == (d.kind == 'win' || d.kind == 'lose' ? houseCut : 0)
        && onlyChanged(before, after, ['balance', 'seq', 'room']);
    }

    // ── 환전가 거래소 ──
    // 시세는 기록원만 쓴다(market/h{시간}). 진입·정산은 플레이어 장부 + 이 규칙이 계산을 다시 해서 검증한다.
    // 계산식은 packages/core/src/market/position.ts와 같다.
    match /oracles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list, write: if isAdmin();
    }

    match /market/{id} {
      allow read: if signedIn();
      allow create, update: if isOracle();
      allow delete: if isAdmin();
    }

    match /marketFeed/{id} {
      allow read: if signedIn();
      allow create: if isOracle() || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /marketNews/{id} {
      allow read: if isAdmin() || isOracle();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isOracle() && onlyChanged(resource.data, request.resource.data, ['status', 'publishedSeq', 'whispered']));
    }

    // 거래소 2부: 애널리스트 리포트(기록원이 쓴다)와 딜러가 예고하는 금리 결정.
    match /marketReports/{id} {
      allow read: if signedIn();
      allow create: if isOracle();
      allow update, delete: if isAdmin();
    }

    // 4단계 숨은 국면: 지금 국면은 기록원과 딜러만 본다. 딜러는 국면 발동을 예약한다.
    match /oracleState/{id} {
      allow read: if isAdmin() || isOracle();
      allow write: if isOracle();
    }

    match /marketRegimes/{id} {
      allow read: if isAdmin() || isOracle();
      allow create: if isAdmin() && request.resource.data.status == 'pending'
        && request.resource.data.kind in ['sideways', 'bull', 'bear', 'fear', 'altseason']
        && request.resource.data.minutes is int && request.resource.data.minutes >= 5 && request.resource.data.minutes <= 1440
        && request.resource.data.at is timestamp;
      allow update: if (isAdmin() && onlyChanged(resource.data, request.resource.data, ['status']) && request.resource.data.status == 'cancelled')
        || (isOracle() && resource.data.status == 'pending' && onlyChanged(resource.data, request.resource.data, ['status', 'appliedSeq'])
            && request.resource.data.status == 'done' && request.resource.data.appliedSeq is int);
      allow delete: if isAdmin();
    }

    match /marketEvents/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() && request.resource.data.kind == 'rate' && request.resource.data.status == 'pending'
        && request.resource.data.bps is int && request.resource.data.bps >= 0 && request.resource.data.bps <= 1000
        && request.resource.data.at is timestamp;
      allow delete: if isAdmin() && resource.data.status == 'pending';
      allow update: if (isAdmin() && onlyChanged(resource.data, request.resource.data, ['status']) && request.resource.data.status == 'cancelled')
        || (isOracle() && resource.data.status == 'pending' && onlyChanged(resource.data, request.resource.data, ['status', 'appliedSeq'])
            && request.resource.data.status == 'done' && request.resource.data.appliedSeq is int);
    }

    function positionPath(id) { return /databases/$(database)/documents/positions/$(id); }
    function marketPath(hour) { return /databases/$(database)/documents/market/$('h' + string(hour)); }
    function marketConfig() { return get(/databases/$(database)/documents/config/market).data; }
    function marketCounters(w) { return w.get('market', {'period': -1, 'used': 0, 'open': 0}); }

    match /positions/{id} {
      allow get, list: if isAdmin() || isOracle()
        || (signedIn() && exists(bindingPath()) && resource.data.playerId == myPid() && isPlayer(myPid()));
      // 포지션 문서는 여기서, 코인 계산은 함께 만들어지는 장부 규칙에서 검증한다(식 1000개 한도 때문에 나눈다).
      allow create: if signedIn() && positionCreateOk(id, request.resource.data);
      allow update: if (isOracle() && oracleEndOk(resource.data, request.resource.data))
        || (isAdmin() && resource.data.status == 'open' && onlyChanged(resource.data, request.resource.data, ['status']) && request.resource.data.status == 'void')
        || (signedIn() && settleOk(id, resource.data, request.resource.data));
      allow delete: if false;
    }

    // 기록원: 새 시세가 청산가나 수익 상한에 닿은 포지션을 표시만 한다(코인은 움직이지 않는다).
    function oracleEndOk(p0, p1) {
      return p0.status == 'open'
        && onlyChanged(p0, p1, ['status', 'exit', 'exitSeq', 'exitAt', 'exitF'])
        && ((p1.status == 'liquidated' && p1.exit == p0.liq) || (p1.status == 'capped' && p0.cap > 0 && p1.exit == p0.cap))
        && p1.exitSeq is int && p1.exitAt is timestamp && p1.get('exitF', 0) is int;
    }

    // 지금 가장 최신 틱인가: 같은 시간 문서의 last이고, 다음 시간 문서가 아직 없고, 너무 오래되지 않았다.
    function tickOk(hour, seq, tick, m) {
      return hour is int && seq is int && tick.seq == seq
        && !exists(marketPath(hour + 1))
        && request.time < tick.at + duration.value(m.get('staleSeconds', 90), 's');
    }

    // floor(a / b) == q (b > 0), 정수만으로.
    function isFloor(q, a, b) { return q is int && q * b <= a && (q + 1) * b > a; }

    // 수수료 = max(minFee, floor(명목가 × feeBps / 10000))
    function feeOk(fee, notional, m) {
      return fee is int && ((fee == m.minFee && notional * m.feeBps < (m.minFee + 1) * 10000)
        || (fee > m.minFee && isBpsFloor(fee, notional, m.feeBps)));
    }

    function maxLeverage(m, coin, econ) {
      let open = econ.gambling.houseOpen == true;
      let main = coin == 'FTN';
      return open ? (main ? m.leverage.mainOpen : m.leverage.altOpen) : (main ? m.leverage.mainLocked : m.leverage.altLocked);
    }

    // 청산가 = 진입가 ∓ floor(진입가 × liquidationBps / (배율 × 10000))
    function liqOk(liq, entry, side, lev, bps) {
      return liq is int && isFloor(side == 'long' ? entry - liq : liq - entry, entry * bps, lev * 10000);
    }

    // 수익 상한가 = 진입가 ± floor(진입가 × capMultiple / 배율). 숏은 0 이하가 되면 상한 없음(0).
    function capOk(cap, entry, side, lev, cm) {
      return cap is int && (side == 'long'
        ? isFloor(cap - entry, entry * cm, lev)
        : (cm >= lev ? cap == 0 : isFloor(entry - cap, entry * cm, lev)));
    }

    function marketOpenOk(entryId, e, before, after) {
      let d = e.detail;
      let m = marketConfig();
      let econ = get(configPath()).data;
      let tick = get(marketPath(d.hour)).data.last;
      let p = getAfter(positionPath(entryId)).data;
      let c0 = marketCounters(before);
      let period = curPeriod(econ.get('limitPeriod', 'day'));
      let used = (c0.period == period ? c0.used : 0) + 1;
      let notional = d.margin * d.leverage;
      return d.keys().hasOnly(['coin', 'side', 'leverage', 'margin', 'fee', 'entry', 'hour', 'seq'])
        && m.enabled == true && m.coins[d.coin].enabled == true
        && (d.side == 'long' || d.side == 'short')
        && d.leverage is int && d.leverage in m.leverage.steps && d.leverage <= maxLeverage(m, d.coin, econ)
        && d.margin is int && d.margin >= m.minMargin && d.margin <= m.maxMargin
        && tickOk(d.hour, d.seq, tick, m) && d.entry == tick.p[d.coin] && entryOpen(m, d.coin, tick)
        && feeOk(d.fee, notional, m)
        && e.delta == -(d.margin + d.fee) && e.debtDelta == 0 && e.vaultDelta == d.margin + d.fee
        && after.market == {'period': period, 'used': used, 'open': c0.open + 1}
        && used <= m.dailyLimit && c0.open + 1 <= m.maxOpen
        && onlyChanged(before, after, ['balance', 'seq', 'market'])
        && p.lastLedger == entryId;
    }

    function positionCreateOk(id, p) {
      let e = getAfter(ledgerPath(id)).data;
      return ledgerCreatedNow(id) && e.type == 'marketOpen' && positionOk(id, p, e.detail, e.playerId, marketConfig());
    }

    // 정산 장부가 가리키는 대로 닫힌다. 직접 청산이면 종료가·틱·시각이 함께 찍힌다.
    function settleOk(id, p0, p1) {
      let e = getAfter(ledgerPath(p1.lastLedger)).data;
      let d = e.detail;
      return p1.lastLedger is string && ledgerCreatedNow(p1.lastLedger) && e.type == 'marketClose' && d.positionId == id
        && onlyChanged(p0, p1, ['status', 'outcome', 'exit', 'exitSeq', 'exitAt', 'payout', 'lastLedger'])
        && p1.status == 'closed' && p1.outcome == d.kind && p1.payout == d.payout
        && (d.kind == 'close' ? (p1.exit == d.exit && p1.exitSeq == d.seq && p1.exitAt == request.time)
                              : (p1.exit == p0.exit && p1.exitSeq == p0.exitSeq && p1.exitAt == p0.exitAt))
        && (d.kind == 'close' ? closeMathOk(d, p0, marketConfig(), request.time, get(marketPath(d.hour)).data.last.st.coins[p0.coin].get('F', 0))
            : d.kind == 'cap' ? closeMathOk(d, p0, marketConfig(), p0.exitAt, p0.get('exitF', p0.get('F0', 0)))
            : true);
    }

    function positionOk(id, p, d, pid, m) {
      return p.keys().hasOnly(['playerId', 'coin', 'side', 'leverage', 'margin', 'fee', 'entry', 'entrySeq', 'openedAt', 'liq', 'cap', 'status', 'exit', 'exitSeq', 'exitAt', 'outcome', 'payout', 'lastLedger', 'F0'])
        // 펀딩(5단계): 진입 틱의 누적 펀딩 지수를 기록한다.
        && p.get('F0', 0) == get(marketPath(d.hour)).data.last.st.coins[d.coin].get('F', 0)
        && p.playerId == pid && p.coin == d.coin && p.side == d.side && p.leverage == d.leverage && p.margin == d.margin && p.fee == d.fee
        && p.entry == d.entry && p.entrySeq == d.seq && p.openedAt == request.time && p.status == 'open'
        && p.exit == null && p.exitSeq == null && p.exitAt == null && p.outcome == null && p.payout == null && p.lastLedger == id
        && liqOk(p.liq, d.entry, d.side, d.leverage, m.liquidationBps)
        && capOk(p.cap, d.entry, d.side, d.leverage, m.capMultiple);
    }

    // 정산: 직접 청산(close, 최신 틱 가격), 자동 익절(cap), 강제 청산(liquidated), 딜러 무효(refund).
    function marketCloseOk(entryId, e, before, after) {
      let d = e.detail;
      let p0 = get(positionPath(d.positionId)).data;
      let p1 = getAfter(positionPath(d.positionId)).data;
      let m = marketConfig();
      let c0 = marketCounters(before);
      let manual = d.kind == 'close';
      return d.keys().hasOnly(['positionId', 'coin', 'side', 'leverage', 'margin', 'kind', 'exit', 'hour', 'seq', 'hours', 'pnl', 'interest', 'fee', 'funding', 'payout', 'levy'])
        && p0.playerId == e.playerId
        && d.coin == p0.coin && d.side == p0.side && d.leverage == p0.leverage && d.margin == p0.margin
        // 손익·이자·펀딩·수수료·지급액 계산은 함께 바뀌는 포지션 문서 규칙(settleOk)이 검증한다(식 1000개 한도 때문에 나눈다).
        && ((manual && p0.status == 'open' && closeExitOk(d, p0, m))
            || (d.kind == 'cap' && p0.status == 'capped' && d.exit == p0.exit && d.hour == null && d.seq == null)
            || (d.kind == 'liquidated' && p0.status == 'liquidated' && d.exit == p0.exit && d.hour == null && d.seq == null
                && d.hours == 0 && d.pnl == -d.margin && d.interest == 0 && d.fee == 0 && d.get('funding', 0) == 0 && d.payout == 0)
            || (d.kind == 'refund' && p0.status == 'void' && d.exit == p0.entry && d.hour == null && d.seq == null
                && d.hours == 0 && d.pnl == 0 && d.interest == 0 && d.fee == 0 && d.get('funding', 0) == 0 && d.payout == d.margin))
        && p1.status == 'closed' && p1.lastLedger == entryId
        && weekOk(d, before, after, d.payout - (p0.margin + p0.fee), m)
        && e.delta == d.payout - d.levy && e.debtDelta == 0 && e.vaultDelta == d.levy - d.payout
        && after.market == {'period': c0.period, 'used': c0.used, 'open': c0.open - 1}
        && onlyChanged(before, after, ['balance', 'seq', 'market', 'marketWeek']);
    }

    // 환전가 특별 징수 (docs/SPEC-MARKET-DEPTH.md 6-5): 이번 주(월요일 0시 KST부터) 거래소 순이익이 상한을 넘는 몫은
    // 지급하지 않고 금고에 남긴다. 같은 주 손실은 이익을 깎고, 주가 바뀌면 0부터. 계산식은 core weeklyLevy와 같다.
    function weekNet0(before) {
      let w0 = before.get('marketWeek', {'week': -1, 'net': 0});
      return w0.week == curWeek() ? w0.net : 0;
    }
    function weekOk(d, before, after, profit, m) {
      let net0 = weekNet0(before);
      let cap = m.get('weeklyProfitCap', 5000);
      let over = net0 + profit - cap;
      let gain = profit > 0 ? profit : 0;
      return d.levy == (cap <= 0 || over <= 0 ? 0 : (over < gain ? over : gain))
        && after.marketWeek == {'week': curWeek(), 'net': net0 + profit - d.levy};
    }

    function closeExitOk(d, p0, m) {
      let tick = get(marketPath(d.hour)).data.last;
      return tickOk(d.hour, d.seq, tick, m) && d.exit == tick.p[p0.coin];
    }

    // 손익 = floor(명목가 × 가격 변화 / 진입가), 이자 = floor(빌린 돈 × 시간 × interestBps / 10000),
    // 청산 수수료 = 진입 수수료 (무월 코인은 밤 0~5시에 nightFeeMultiplier배), 지급 = max(0, 증거금 + min(손익, 상한) − 이자 − 수수료)
    // 펀딩 = floor(명목가 × (F − F₀) × 방향 / 1,000,000), 롱은 F가 오르면 내고 숏은 받는다. F₀ 없는 예전 포지션은 0.
    function closeMathOk(d, p0, m, closedAt, F) {
      let notional = p0.margin * p0.leverage;
      let F0 = p0.get('F0', null);
      let funding = d.get('funding', 0);
      let elapsedMs = closedAt.toMillis() - p0.openedAt.toMillis();
      let night = p0.coin == 'MWL' && (closedAt.toMillis() + 32400000) % 86400000 < 18000000;
      let gain = d.pnl < p0.margin * m.capMultiple ? d.pnl : p0.margin * m.capMultiple;
      let raw = p0.margin + gain - d.interest - d.fee - funding;
      return d.hours is int && d.hours >= 1 && elapsedMs <= d.hours * 3600000 && (d.hours == 1 || elapsedMs > (d.hours - 1) * 3600000)
        && isFloor(d.pnl, notional * (p0.side == 'long' ? d.exit - p0.entry : p0.entry - d.exit), p0.entry)
        && isBpsFloor(d.interest, (notional - p0.margin) * d.hours, m.interestBps)
        && d.fee == p0.fee * (night ? m.nightFeeMultiplier : 1)
        && (F0 == null ? funding == 0 : isFloor(funding, notional * (F - F0) * (p0.side == 'long' ? 1 : -1), 1000000))
        && d.payout == (raw > 0 ? raw : 0);
    }

    // 간부전 예고 뒤에는 그 종목의 새 진입·매수를 막는다. 해방이 시세에 반영되면(틱의 liberated) 다시 열린다.
    // 종목 → 구역은 packages/core/src/market/coins.ts와 같다.
    function coinDistrict(coin) {
      return {'FTN': '', 'WHL': 'downtown', 'HBT': 'modern', 'LNH': 'medieval', 'JWN': 'wuxia', 'S9': 'cyberpunk', 'ORB': 'scifi', 'BLC': 'romance', 'MWL': 'horror'}[coin];
    }
    function entryOpen(m, coin, tick) {
      return m.coins[coin].get('paused', false) != true || coinDistrict(coin) in tick.st.liberated;
    }

    // ── 현물 ── 보유량은 1/10000개 단위(units), 가격은 1/100 단위. 금액 = units × 가격 / 1,000,000.
    function holdingPath(pid, coin) { return /databases/$(database)/documents/holdings/$(pid + '_' + coin); }

    match /holdings/{id} {
      // get은 아직 없는 문서(첫 매수 전)도 허용해야 하므로 문서 id로 판단한다.
      allow get: if isAdmin() || isOracle() || (signedIn() && exists(bindingPath()) && id.matches(myPid() + '_[A-Z0-9]+') && isPlayer(myPid()));
      allow list: if isAdmin() || isOracle()
        || (signedIn() && exists(bindingPath()) && resource.data.playerId == myPid() && isPlayer(myPid()));
      allow create: if signedIn() && holdingOk(id, null, request.resource.data);
      allow update: if signedIn() && holdingOk(id, resource.data, request.resource.data);
      allow delete: if false;
    }

    // 보유 문서는 함께 만들어지는 현물 장부가 말하는 만큼만 바뀐다. 금액 계산은 장부 규칙이 한다.
    function holdingOk(id, h0, h1) {
      let e = getAfter(ledgerPath(h1.lastLedger)).data;
      let d = e.detail;
      let units0 = h0 == null ? 0 : h0.units;
      let cost0 = h0 == null ? 0 : h0.cost;
      return h1.lastLedger is string && ledgerCreatedNow(h1.lastLedger)
        && id == e.playerId + '_' + d.coin
        && h1.keys().hasOnly(['playerId', 'coin', 'units', 'cost', 'lastLedger'])
        && h1.playerId == e.playerId && h1.coin == d.coin
        && ((e.type == 'spotBuy' && h1.units == units0 + d.units && h1.cost == cost0 + d.amount)
            || (e.type == 'spotSell' && h1.units == units0 - d.units && h1.cost == cost0 - d.costOut));
    }

    function spotBuyOk(entryId, e, before, after) {
      let d = e.detail;
      let m = marketConfig();
      let econ = get(configPath()).data;
      let tick = get(marketPath(d.hour)).data.last;
      let s0 = before.get('spot', {'period': -1, 'used': 0});
      let period = curPeriod(econ.get('limitPeriod', 'day'));
      let used = (s0.period == period ? s0.used : 0) + 1;
      return d.keys().hasOnly(['coin', 'amount', 'fee', 'price', 'units', 'hour', 'seq'])
        && m.enabled == true && m.coins[d.coin].enabled == true
        && d.amount is int && d.amount >= m.minMargin && d.amount <= m.get('spotMaxOrder', 2000)
        && tickOk(d.hour, d.seq, tick, m) && d.price == tick.p[d.coin] && entryOpen(m, d.coin, tick)
        && feeOk(d.fee, d.amount, m)
        && isFloor(d.units, d.amount * 1000000, d.price) && d.units >= 1
        && e.delta == -(d.amount + d.fee) && e.debtDelta == 0 && e.vaultDelta == d.amount + d.fee
        && after.spot == {'period': period, 'used': used} && used <= m.get('spotDailyLimit', 20)
        && onlyChanged(before, after, ['balance', 'seq', 'spot'])
        && getAfter(holdingPath(e.playerId, d.coin)).data.lastLedger == entryId;
    }

    // 매도는 횟수를 세지 않고, 거래 정지·간부전 대기 중에도 된다.
    function spotSellOk(entryId, e, before, after) {
      let d = e.detail;
      let m = marketConfig();
      let tick = get(marketPath(d.hour)).data.last;
      let h0 = get(holdingPath(e.playerId, d.coin)).data;
      return d.keys().hasOnly(['coin', 'units', 'price', 'gross', 'fee', 'payout', 'costOut', 'levy', 'hour', 'seq'])
        && tickOk(d.hour, d.seq, tick, m) && d.price == tick.p[d.coin]
        && d.units is int && d.units >= 1 && d.units <= h0.units
        && isFloor(d.gross, d.units * d.price, 1000000)
        && feeOk(d.fee, d.gross, m)
        && d.payout == (d.gross - d.fee > 0 ? d.gross - d.fee : 0)
        && (d.units == h0.units ? d.costOut == h0.cost : isFloor(d.costOut, h0.cost * d.units, h0.units))
        && weekOk(d, before, after, d.payout - d.costOut, m)
        && e.delta == d.payout - d.levy && e.debtDelta == 0 && e.vaultDelta == d.levy - d.payout
        && onlyChanged(before, after, ['balance', 'seq', 'marketWeek'])
        && getAfter(holdingPath(e.playerId, d.coin)).data.lastLedger == entryId;
    }

    // ── 도시: 노선도와 장면 ── (docs/SPEC-CITY-MAP.md 2판) 코인은 특기 결제 장부로만 움직인다.
    function cityPlayer() { return signedIn() && exists(bindingPath()) && isPlayer(myPid()); }
    function channelPublic(c) { return c == 'global' || c.matches('place:[a-z0-9-]{1,40}'); }
    function whisperFor(c) { return c.matches('whisper:.+') && c.split(':')[1].split('~').hasAny([myPid()]); }
    function sessionLive(id) {
      let s = get(/databases/$(database)/documents/sessions/$(id)).data;
      return s.closedAt == null && s.closesAt > request.time;
    }
    function imagePath(id) { return /databases/$(database)/documents/sceneImages/$(id); }

    match /actors/{pid} {
      allow read: if isAdmin() || cityPlayer();
      allow create, update: if signedIn() && isPlayer(pid) && actorOk(pid, request.resource.data);
      allow delete: if isAdmin();
    }

    // 1판(걷는 지도)의 칸 필드(fx…at)가 남아 있는 문서도 고칠 수 있게 허용 목록에 둔다.
    function actorOk(pid, a) {
      return a.keys().hasOnly(['kind', 'name', 'sprite', 'portrait', 'place', 'seenAt', 'fx', 'fy', 'tx', 'ty', 'at'])
        && a.kind == 'pc' && a.name == get(playerPath(pid)).data.name
        && a.sprite is map && a.sprite.keys().hasOnly(['skin', 'hair', 'hairColor', 'outfit', 'outfitColor', 'accessory'])
        && (a.get('portrait', null) == null || (a.portrait is string && get(imagePath(a.portrait)).data.owner == 'player' && get(imagePath(a.portrait)).data.ref == pid))
        && a.place is string && a.place.matches('[a-z0-9-]{1,40}')
        && a.seenAt == request.time;
    }

    match /reads/{pid} {
      allow read: if isAdmin() || (signedIn() && isPlayer(pid));
      allow write: if signedIn() && isPlayer(pid) && request.resource.data.size() <= 60;
    }

    match /placeActivity/{place} {
      allow read: if isAdmin() || cityPlayer();
      allow write: if (isAdmin() || cityPlayer())
        && request.resource.data.keys().hasOnly(['lastAt', 'lastName'])
        && request.resource.data.lastAt == request.time
        && request.resource.data.lastName is string && request.resource.data.lastName.size() <= 40;
    }

    match /messages/{id} {
      // 공개 채널은 같은 도시 사람 모두, 귓속말은 두 사람과 딜러만. 1판 메시지(public 없음)도 채널로 판단한다.
      allow read: if isAdmin() || (cityPlayer() && (channelPublic(resource.data.channel) || resource.data.public == true || whisperFor(resource.data.channel)));
      allow create: if (cityPlayer() && playerMessageOk(id, request.resource.data)) || (isAdmin() && dealerMessageOk(request.resource.data));
      allow update: if (cityPlayer() && resource.data.authorId == myPid() && editOk(resource.data, request.resource.data))
        || (isAdmin() && resource.data.authorId == request.auth.uid && editOk(resource.data, request.resource.data))
        || ((cityPlayer() || isAdmin()) && onlyChanged(resource.data, request.resource.data, ['pinned']) && request.resource.data.pinned is bool);
      allow delete: if false;
    }

    function messageBase(m) {
      return m.keys().hasOnly(['channel', 'public', 'kind', 'authorKind', 'authorId', 'authorName', 'npcId', 'text', 'at', 'editedAt', 'deleted', 'pinned', 'sessionId', 'ledgerId', 'skill', 'imageId', 'contestId'])
        && m.channel is string && m.channel.size() <= 100
        && m.public == !m.channel.matches('whisper:.+')
        && m.text is string && m.text.size() <= 2000
        && m.at == request.time && m.editedAt == null && m.deleted == false && m.pinned == false
        && (m.sessionId == null || (m.sessionId is string && sessionLive(m.sessionId)))
        && (m.contestId == null || (m.contestId is string && exists(/databases/$(database)/documents/contests/$(m.contestId))));
    }

    function playerMessageOk(id, m) {
      return messageBase(m)
        && m.authorKind == 'pc' && m.authorId == myPid() && m.authorName == get(playerPath(myPid())).data.name && m.npcId == null && m.imageId == null
        && (channelPublic(m.channel) || whisperFor(m.channel))
        && ((m.kind in ['say', 'act'] && m.text.size() >= 1 && m.ledgerId == null && m.skill == null)
            || (m.kind == 'roll' && m.text.matches('[0-9]{1,2}d[0-9]{1,3}([+-][0-9]{1,3})?') && m.ledgerId == null && m.skill == null)
            || (m.kind == 'skill' && skillMessageOk(id, m)));
    }

    // 특기 결제를 장면에 보이기: 이미 만들어진 내 특기 장부를 가리키고, 문서 id가 그 장부에 묶여 한 번만 보일 수 있다.
    function skillMessageOk(id, m) {
      let e = get(ledgerPath(m.ledgerId)).data;
      return m.ledgerId is string && id == 'skill_' + m.ledgerId && m.channel.matches('place:[a-z0-9-]{1,40}') && m.text.size() >= 1
        && e.type == 'skill' && e.playerId == myPid()
        && m.skill == {'name': e.detail.skillName, 'base': e.detail.baseLevel, 'used': e.detail.usedLevel, 'cost': e.detail.cost};
    }

    function dealerMessageOk(m) {
      return messageBase(m) && m.authorId == request.auth.uid && m.ledgerId == null && m.skill == null
        && ((m.authorKind == 'gm' && m.authorName == '딜러' && m.npcId == null)
            || (m.authorKind == 'narration' && m.authorName == '' && m.npcId == null)
            || (m.authorKind == 'npc' && m.npcId is string && get(/databases/$(database)/documents/npcs/$(m.npcId)).data.name == m.authorName))
        && ((m.kind in ['say', 'act', 'result'] && m.text.size() >= 1 && m.imageId == null)
            || (m.kind == 'roll' && m.text.matches('[0-9]{1,2}d[0-9]{1,3}([+-][0-9]{1,3})?') && m.imageId == null)
            || (m.kind == 'image' && m.imageId is string && exists(imagePath(m.imageId))));
    }

    // 주사위와 특기 결제는 고치거나 지울 수 없다.
    function editOk(m0, m1) {
      return !(m0.kind in ['roll', 'skill']) && m0.deleted == false
        && onlyChanged(m0, m1, ['text', 'editedAt', 'deleted'])
        && m1.editedAt == request.time
        && ((m1.deleted == true && m1.text == '') || (m1.deleted == false && m1.text is string && m1.text.size() >= 1 && m1.text.size() <= 2000));
    }

    match /scenes/{place} {
      allow read: if isAdmin() || cityPlayer();
      allow write: if isAdmin();
    }

    match /sceneImages/{id} {
      allow read: if signedIn();
      allow create: if imageOk(id, request.resource.data)
        && ((isAdmin() && request.resource.data.owner in ['place', 'npc', 'cut'])
            || (cityPlayer() && request.resource.data.owner == 'player' && request.resource.data.ref == myPid()));
      allow update: if (isAdmin() || (cityPlayer() && resource.data.owner == 'player' && resource.data.ref == myPid()))
        && onlyChanged(resource.data, request.resource.data, ['name', 'filter', 'focus', 'sense', 'credit'])
        && request.resource.data.filter in ['soft', 'strong', 'frame'] && request.resource.data.focus in ['top', 'center', 'bottom'];
      allow delete: if isAdmin() || (cityPlayer() && resource.data.owner == 'player' && resource.data.ref == myPid());
    }

    function imageOk(id, i) {
      return i.keys().hasOnly(['owner', 'ref', 'path', 'url', 'name', 'filter', 'focus', 'sense', 'credit', 'createdAt', 'createdBy'])
        && i.path == 'uploads/' + request.auth.uid + '/' + id + '.webp'
        && i.url is string && i.url.size() <= 2000 && i.ref is string && i.ref.size() <= 60
        && i.filter in ['soft', 'strong', 'frame'] && i.focus in ['top', 'center', 'bottom']
        && i.name is string && i.name.size() <= 60 && i.sense is string && i.sense.size() <= 120 && i.credit is string && i.credit.size() <= 200
        && i.createdAt == request.time && i.createdBy == request.auth.uid;
    }

    match /npcs/{id} {
      allow read: if isAdmin() || cityPlayer();
      allow write: if isAdmin();
      match /secret/{name} { allow read, write: if isAdmin(); }
    }

    match /sessions/{id} {
      allow read: if isAdmin() || cityPlayer();
      allow write: if isAdmin();
    }

    match /contests/{id} {
      allow read: if isAdmin() || cityPlayer();
      allow write: if isAdmin();
    }

    // ── 디스코드 알림 ──
    // 이벤트 문서는 근거 장부(또는 관리자)가 있어야 만들 수 있다. 중계 Worker가 읽고 sentAt을 찍는다.
    match /events/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.actorUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.sentAt == null
        && (isAdmin() || (request.resource.data.ledgerId is string
              && ledgerCreatedNow(request.resource.data.ledgerId)
              && id == request.resource.data.ledgerId));
      allow update: if signedIn() && (resource.data.actorUid == request.auth.uid || isAdmin())
        && onlyChanged(resource.data, request.resource.data, ['sentAt'])
        && resource.data.sentAt == null && request.resource.data.sentAt == request.time;
      allow delete: if isAdmin();
    }
  }
}
