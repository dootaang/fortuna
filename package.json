{
  "name": "fortuna",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @fortuna/web dev",
    "dev:emu": "firebase emulators:start --only auth,firestore,storage --project demo-fortuna",
    "build": "corepack pnpm -r --if-present build",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r --filter !@fortuna/rules-tests test",
    "test:rules": "node scripts/with-emulators.mjs corepack pnpm --filter @fortuna/rules-tests test",
    "check": "corepack pnpm typecheck && corepack pnpm test && corepack pnpm test:rules && corepack pnpm build",
    "test:e2e": "node scripts/with-emulators.mjs corepack pnpm exec playwright test",
    "release": "corepack pnpm build && firebase deploy --only hosting,firestore,storage"
  },
  "devDependencies": {
    "@fortuna/core": "workspace:*",
    "@fortuna/data": "workspace:*",
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.3",
    "firebase": "12.19.0",
    "firebase-tools": "15.32.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
